{
  "name": "technoseller-portal",
  "version": "0.2.0",
  "private": false,
  "type": "module",
  "description": "A public SaaS marketplace and vendor directory concept for business services, regions, and trade opportunities.",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:frontend": "vite --host 127.0.0.1",
    "dev:backend": "node server.mjs",
    "db:generate": "prisma generate",
    "db:push": "prisma migrate dev --skip-generate",
    "db:migrate": "prisma migrate dev --skip-generate",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node prisma/seed.mjs",
    "db:studio": "prisma studio",
    "setup": "npm run db:generate && npm run db:push && npm run db:seed && npm run build",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "server": "node server.mjs",
    "start": "node server.mjs",
    "test": "prisma migrate deploy && node --test tests/*.test.mjs"
  },
  "keywords": [
    "marketplace",
    "directory",
    "saas",
    "vendor-portal",
    "lead-generation"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@prisma/client": "^6.19.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "prisma": "^6.19.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^7.3.2"
  }
}
